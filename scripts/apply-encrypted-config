#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

CIPHERTEXT="${1:-config.yaml.enc}"
PLAINTEXT="${2:-config.yaml}"
AGE_KEY_FILE="${SOPS_AGE_KEY_FILE:-${AGE_KEY_FILE:-/etc/notifybot/age.key}}"
SOPS_BIN="${SOPS_BIN:-sops}"
RELOAD_STATUS_PATH="${RELOAD_STATUS_PATH:-archives/reload-status.json}"
WAIT_RELOAD="${WAIT_RELOAD:-0}"
WAIT_SECONDS="${WAIT_SECONDS:-90}"

if [[ ! -f "$CIPHERTEXT" ]]; then
  echo "error: encrypted config not found: $CIPHERTEXT" >&2
  exit 1
fi
if ! command -v "$SOPS_BIN" >/dev/null 2>&1; then
  echo "error: sops not found (SOPS_BIN=$SOPS_BIN)" >&2
  exit 1
fi
if [[ ! -f "$AGE_KEY_FILE" ]]; then
  echo "error: age private key not found: $AGE_KEY_FILE" >&2
  echo "Place the host private key at /etc/notifybot/age.key (mode 600) or set SOPS_AGE_KEY_FILE." >&2
  exit 1
fi

export SOPS_AGE_KEY_FILE="$AGE_KEY_FILE"

tmpdir="$(mktemp -d)"
cleanup() { rm -rf "$tmpdir"; }
trap cleanup EXIT

decoded="$tmpdir/config.yaml"
# Encrypted blob is a sops YAML envelope over the original file bytes.
"$SOPS_BIN" --decrypt --input-type yaml --output-type binary "$CIPHERTEXT" >"$decoded"

if command -v python3 >/dev/null 2>&1; then
  python3 - "$decoded" <<'PY'
import sys
from pathlib import Path
try:
    import yaml
except ImportError:
    text = Path(sys.argv[1]).read_text(encoding="utf-8")
    if "ws_url:" not in text or "ws_token:" not in text:
        raise SystemExit("decoded config missing required markers")
    print("basic ok")
    raise SystemExit(0)

path = sys.argv[1]
with open(path, "r", encoding="utf-8") as f:
    data = yaml.safe_load(f)
if not isinstance(data, dict):
    raise SystemExit("decoded config is not a mapping")
required = ["ws_url", "ws_token", "internal_group_id"]
missing = [k for k in required if k not in data]
if missing:
    raise SystemExit(f"decoded config missing keys: {', '.join(missing)}")
print("yaml ok")
PY
fi

old_mtime="0"
if [[ -f "$PLAINTEXT" ]]; then
  old_mtime="$(stat -c %Y "$PLAINTEXT" 2>/dev/null || stat -f %m "$PLAINTEXT" 2>/dev/null || echo 0)"
fi

mkdir -p "$(dirname "$PLAINTEXT")"
tmp_plain="${PLAINTEXT}.tmp.$$"
cp "$decoded" "$tmp_plain"
mv "$tmp_plain" "$PLAINTEXT"
echo "applied encrypted config -> $PLAINTEXT"

if [[ "$WAIT_RELOAD" == "1" ]]; then
  echo "waiting up to ${WAIT_SECONDS}s for bot reload status..."
  deadline=$((SECONDS + WAIT_SECONDS))
  while (( SECONDS < deadline )); do
    if [[ -f "$RELOAD_STATUS_PATH" ]]; then
      if python3 - "$RELOAD_STATUS_PATH" "$old_mtime" <<'PY'
import json, sys
path, old_mtime = sys.argv[1], float(sys.argv[2])
with open(path, "r", encoding="utf-8") as f:
    data = json.load(f)
ok = bool(data.get("ok"))
cfg_mtime = float(data.get("config_mtime") or 0)
if ok and cfg_mtime >= old_mtime:
    print("reload status ok")
    raise SystemExit(0)
raise SystemExit(1)
PY
      then
        exit 0
      fi
    fi
    sleep 2
  done
  echo "error: timed out waiting for config reload status at $RELOAD_STATUS_PATH" >&2
  exit 1
fi