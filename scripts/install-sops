#!/usr/bin/env bash
# Idempotent sops installer. Installs into the project-local .tools/bin so it
# never touches system paths or needs sudo; the config-encrypt /
# apply-encrypted-config scripts (bash and PowerShell) pick it up
# automatically. Usage: bash scripts/install-sops [version]
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SOPS_VERSION="${1:-${SOPS_VERSION:-v3.13.3}}"
INSTALL_DIR="${INSTALL_DIR:-$ROOT_DIR/.tools/bin}"
VER="${SOPS_VERSION#v}"
# Override the download source when the host cannot reach GitHub releases.
BASE="${SOPS_RELEASE_BASE:-https://github.com/getsops/sops/releases/download/${SOPS_VERSION}}"

case "$(uname -s)" in
  Linux) OS=linux ;;
  Darwin) OS=darwin ;;
  MINGW* | MSYS* | CYGWIN*) OS=windows ;;
  *)
    echo "error: unsupported OS: $(uname -s)" >&2
    exit 1
    ;;
esac

case "$(uname -m)" in
  x86_64) ARCH=amd64 ;;
  aarch64 | arm64) ARCH=arm64 ;;
  *)
    echo "error: unsupported architecture: $(uname -m)" >&2
    exit 1
    ;;
esac

case "$OS" in
  windows) ASSET="sops-${SOPS_VERSION}.${ARCH}.exe"; OUT="sops.exe" ;;
  darwin) ASSET="sops-${SOPS_VERSION}.darwin.${ARCH}"; OUT="sops" ;;
  *) ASSET="sops-${SOPS_VERSION}.${OS}.${ARCH}"; OUT="sops" ;;
esac

SOPS_LOCAL="$INSTALL_DIR/$OUT"
if [ -x "$SOPS_LOCAL" ] && "$SOPS_LOCAL" --version 2>&1 | grep -Fqw "$VER"; then
  echo "sops ${SOPS_VERSION} already installed at $SOPS_LOCAL"
  exit 0
fi

tmp="$(mktemp -d)"
cleanup() { rm -rf "$tmp"; }
trap cleanup EXIT

curl -fsSL -o "$tmp/$ASSET" "${BASE}/${ASSET}"
curl -fsSL -o "$tmp/checksums.txt" "${BASE}/sops-${SOPS_VERSION}.checksums.txt"

# checksums.txt is sha256sum-formatted; anchor on the exact asset name so
# similarly prefixed artifacts (e.g. *.spdx.sbom.json) cannot match. The
# download must keep the Release asset name: sha256sum -c reads the target
# filename from each checksums.txt line.
(cd "$tmp" && grep "${ASSET}\$" checksums.txt | sha256sum -c -)

mkdir -p "$INSTALL_DIR"
install -m 0755 "$tmp/$ASSET" "$SOPS_LOCAL"
"$SOPS_LOCAL" --version
echo "installed sops ${SOPS_VERSION} -> $SOPS_LOCAL"
